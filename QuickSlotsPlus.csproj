<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <!-- Set before Microsoft.Common.props, which is where MSBuildProjectExtensionsPath is read.
         Configuration is normally defaulted below, but that is too late for this. -->
    <Configuration Condition=" '$(Configuration)' == '' ">Subnautica</Configuration>
    <!-- The two configurations reference different GameLibs packages, while NuGet writes a single
         project.assets.json per project. Without a per-configuration path, building one game after
         restoring for the other compiles against the wrong game's assemblies and LabelUtil.cs fails
         with CS0117 on GameInput.GetBindingName and friends. -->
    <MSBuildProjectExtensionsPath>$(MSBuildProjectDirectory)\obj\$(Configuration)\</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Subnautica</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{BB85C5A1-8FC2-4065-9DA4-91A20B5B77AE}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>QuickSlotsPlus</RootNamespace>
    <AssemblyName>QuickSlotsPlus</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>11</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <RestoreAdditionalProjectSources>https://api.nuget.org/v3/index.json;https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Subnautica|AnyCPU' ">
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\Subnautica</GameDir>
    <OutputPath>build\Subnautica\</OutputPath>
    <DefineConstants>SUBNAUTICA</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'BelowZero|AnyCPU'">
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\SubnauticaZero</GameDir>
    <OutputPath>build\BelowZero\</OutputPath>
    <DefineConstants>BELOWZERO</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="1.1.0" />
    <PackageReference Include="UnityEngine.Modules" Version="2019.4.36" IncludeAssets="compile" />
    <PackageReference Include="PolySharp" Version="1.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Subnautica'">
    <PackageReference Include="Subnautica.GameLibs" Version="82304.0.0-r.0" />
    <PackageReference Include="Subnautica.Nautilus" Version="1.0.0-pre.46" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'BelowZero'">
    <PackageReference Include="Subnautica.BelowZero.GameLibs" Version="71288.0.0-r.0" />
    <PackageReference Include="SubnauticaZero.Nautilus" Version="1.*-*" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Patches\GameInput_Patch.cs" />
    <Compile Include="Patches\GameInputSystem_Initialize_Patch.cs" />
    <Compile Include="Patches\QuickSlots_BindToEmpty_Patch.cs" />
    <Compile Include="Patches\uGUI_QuickSlots_Init_Patch.cs" />
    <Compile Include="QuickSlotsPlus.cs" />
    <Compile Include="StandardConfig.cs" />
    <Compile Include="Patches\Inventory_Awake_Patch.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Patches\QuickSlots_SlotNames_Patch.cs" />
    <Compile Include="Utility\LabelUtil.cs" />
    <Compile Include="Utility\InputHandler.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".gitignore" />
    <None Include="LICENSE" />
    <None Include="README.md" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <PropertyGroup Condition="'$(Configuration)' == 'Subnautica'">
    <PostBuildEvent>xcopy /F /Y "$(TargetPath)" "$(ProjectDir)release\$(Configuration)\BepInEx\plugins\QuickSlotsPlus\"
rem The game memory-maps the plugin DLL, so xcopy cannot replace it while the game is running - and it
rem deletes the old file before discovering that, leaving the install with no mod at all. Skip the copy
rem into $(GameDir) instead; a running game could not pick up a new DLL anyway.
tasklist /FI "IMAGENAME eq Subnautica.exe" | find /I "Subnautica.exe" &gt; nul
if not errorlevel 1 goto SkipInstall
xcopy /F /Y "$(TargetPath)" "$(GameDir)\BepInEx\plugins\QuickSlotsPlus\"
xcopy /E /I /F /Y "$(ProjectDir)release\$(Configuration)\BepInEx\plugins\QuickSlotsPlus\Localization" "$(GameDir)\BepInEx\plugins\QuickSlotsPlus\Localization\"
goto InstallDone
:SkipInstall
echo Subnautica is running - skipped installing into "$(GameDir)".
:InstallDone</PostBuildEvent>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'BelowZero'">
    <PostBuildEvent>xcopy /F /Y "$(TargetPath)" "$(ProjectDir)release\$(Configuration)\BepInEx\plugins\QuickSlotsPlus_BZ\"
rem See the Subnautica PostBuildEvent above for why the install copy is skipped while the game runs.
tasklist /FI "IMAGENAME eq SubnauticaZero.exe" | find /I "SubnauticaZero.exe" &gt; nul
if not errorlevel 1 goto SkipInstall
xcopy /F /Y "$(TargetPath)" "$(GameDir)\BepInEx\plugins\QuickSlotsPlus_BZ\"
xcopy /E /I /F /Y "$(ProjectDir)release\$(Configuration)\BepInEx\plugins\QuickSlotsPlus_BZ\Localization" "$(GameDir)\BepInEx\plugins\QuickSlotsPlus_BZ\Localization\"
goto InstallDone
:SkipInstall
echo SubnauticaZero is running - skipped installing into "$(GameDir)".
:InstallDone</PostBuildEvent>
  </PropertyGroup>
</Project>